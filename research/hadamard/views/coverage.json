{
  "families": [
    {
      "id": "sylvester",
      "formula": "n = 2^a",
      "conditions": "integer a >= 0"
    },
    {
      "id": "paley-I",
      "formula": "n = q+1",
      "conditions": "q prime power, q % 4 == 3"
    },
    {
      "id": "paley-II",
      "formula": "n = 2*(q+1)",
      "conditions": "q odd prime power, q % 4 == 1"
    },
    {
      "id": "kronecker",
      "formula": "n = a*b",
      "conditions": "a,b already covered; a,b > 1"
    }
  ],
  "symbolic_gap": "{4*k : integer k>0} \\ least_closure(Sylvester \u222a PaleyI \u222a PaleyII, Kronecker)",
  "window": {
    "maximum": 128,
    "uncovered_by_this_model": [
      92,
      116
    ]
  },
  "global_conjecture": "UNRESOLVED",
  "limits": "A finite diagnostic window and an incomplete family model do not identify all globally open orders."
}
